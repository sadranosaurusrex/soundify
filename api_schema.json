{"openapi":"3.0.3","info":{"title":"Soundify API","version":"1.1.0","description":"Complete OpenAPI 3.0 specification for the Soundify Music Streaming Backend (Cloudflare Workers + Hono + D1 + KV). Includes Authentication (JWT + OTP + Password Reset), User Profile, Tracks Catalog & HTTP 206 Audio Streaming, Favorites, Playlists CRUD, and OpenMusic Protocol endpoints."},"servers":[{"url":"https://soundify.easyfound.ir","description":"Active Cloudflare Edge Server"}],"tags":[{"name":"System","description":"Health check and server diagnostics"},{"name":"Auth","description":"Registration, Email OTP verification, JWT login/refresh/logout, and password reset"},{"name":"Users","description":"Authenticated user profile retrieval and updates"},{"name":"Tracks","description":"Music catalog browsing, search, featured tracks, and HTTP Range (206) audio streaming"},{"name":"Favorites","description":"Manage user favorite (liked) tracks"},{"name":"Playlists","description":"Full CRUD management for user playlists and playlist track ordering"},{"name":"OpenMusic","description":"OpenMusic Server Specification compatible root endpoints"}],"components":{"securitySchemes":{"BearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT","description":"JWT Access Token obtained from `/api/v1/auth/login` or `/api/v1/auth/token/refresh`. Format: `Bearer <access_token>`"}},"schemas":{"ErrorResponse":{"type":"object","required":["error"],"properties":{"error":{"type":"object","required":["code","message","details"],"properties":{"code":{"type":"string","example":"invalid_credentials"},"message":{"type":"string","example":"Email or password is incorrect."},"details":{"type":"object","additionalProperties":true,"example":{}}}}}},"UserSummary":{"type":"object","properties":{"id":{"type":"integer","example":1},"username":{"type":"string","example":"student01"},"email":{"type":"string","format":"email","example":"student@example.com"},"display_name":{"type":"string","nullable":true,"example":"Student Demo"},"avatar_url":{"type":"string","nullable":true,"example":"https://example.com/avatar.png"}}},"UserProfile":{"allOf":[{"$ref":"#/components/schemas/UserSummary"},{"type":"object","properties":{"is_verified":{"type":"boolean","example":true},"created_at":{"type":"string","format":"date-time","example":"2026-11-13 12:00:00"}}}]},"TokenPair":{"type":"object","required":["access","refresh"],"properties":{"access":{"type":"string","description":"Short-lived JWT access token"},"refresh":{"type":"string","description":"Long-lived JWT refresh token (rotated on use)"}}},"LoginResponse":{"type":"object","required":["access","refresh","user"],"properties":{"access":{"type":"string","description":"JWT Access Token"},"refresh":{"type":"string","description":"JWT Refresh Token"},"user":{"$ref":"#/components/schemas/UserSummary"}}},"Track":{"type":"object","properties":{"id":{"type":"string","example":"T-GSYNW2VM3LVEQNIHGLU54T3Z5F6X7MHY"},"title":{"type":"string","example":"Paradise"},"artist":{"type":"string","example":"Coldplay"},"album":{"type":"string","example":"Mylo Xyloto"},"cover_url":{"type":"string","format":"uri","example":"https://lh3.googleusercontent.com/..."},"duration":{"type":"integer","description":"Duration in seconds","example":279},"stream_url":{"type":"string","format":"uri","example":"https://soundify.easyfound.ir/api/v1/tracks/T-GSYNW2VM3LVEQNIHGLU54T3Z5F6X7MHY/stream/"},"is_favorite":{"type":"boolean","example":false}}},"FavoriteTrack":{"type":"object","properties":{"id":{"type":"string","example":"T-QAIJ3RWE4MLUPD5VNWPGXS453UW2HYLS"},"title":{"type":"string","example":"Yellow"},"artist":{"type":"string","example":"Coldplay"},"album":{"type":"string","example":"Parachutes"},"cover_url":{"type":"string","format":"uri"},"duration":{"type":"integer","example":267},"stream_url":{"type":"string","format":"uri"}}},"PlaylistTrack":{"allOf":[{"$ref":"#/components/schemas/FavoriteTrack"},{"type":"object","properties":{"position":{"type":"integer","description":"0-based track order index in playlist","example":0}}}]},"PaginatedTracks":{"type":"object","properties":{"count":{"type":"integer","example":331},"next":{"type":"string","format":"uri","nullable":true},"previous":{"type":"string","format":"uri","nullable":true},"results":{"type":"array","items":{"$ref":"#/components/schemas/Track"}}}},"PaginatedFavorites":{"type":"object","properties":{"count":{"type":"integer","example":5},"next":{"type":"string","format":"uri","nullable":true},"previous":{"type":"string","format":"uri","nullable":true},"results":{"type":"array","items":{"$ref":"#/components/schemas/FavoriteTrack"}}}},"Playlist":{"type":"object","properties":{"id":{"type":"integer","example":1},"name":{"type":"string","example":"My Favorites"},"description":{"type":"string","example":"Best tracks to study Flutter"},"is_public":{"type":"boolean","example":false},"track_count":{"type":"integer","example":2},"created_at":{"type":"string","format":"date-time","example":"2026-11-13 12:00:00"},"updated_at":{"type":"string","format":"date-time","example":"2026-11-13 12:00:00"}}},"PlaylistDetail":{"type":"object","properties":{"id":{"type":"integer","example":1},"name":{"type":"string","example":"My Favorites"},"description":{"type":"string","example":"Best tracks to study Flutter"},"is_public":{"type":"boolean","example":false},"track_count":{"type":"integer","example":2},"tracks":{"type":"array","items":{"$ref":"#/components/schemas/PlaylistTrack"}}}},"PaginatedPlaylists":{"type":"object","properties":{"count":{"type":"integer","example":3},"next":{"type":"string","format":"uri","nullable":true},"previous":{"type":"string","format":"uri","nullable":true},"results":{"type":"array","items":{"$ref":"#/components/schemas/Playlist"}}}}}},"paths":{"/health":{"get":{"summary":"Health Check","description":"Returns server health status, API version, environment, and current UTC timestamp.","tags":["System"],"responses":{"200":{"description":"Service is healthy","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","example":"ok"},"version":{"type":"string","example":"1.1"},"environment":{"type":"string","example":"production"},"timestamp":{"type":"string","format":"date-time"}}}}}}}}},"/api/v1/auth/register":{"post":{"summary":"Register User","description":"Creates a new unverified user account and automatically emails a 6-digit OTP verification code (valid for 5 minutes).","tags":["Auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email","username","password"],"properties":{"email":{"type":"string","format":"email","example":"newuser@example.com"},"username":{"type":"string","example":"newuser"},"password":{"type":"string","minLength":8,"example":"StrongPass123"},"display_name":{"type":"string","example":"New User"}}}}}},"responses":{"201":{"description":"Registration successful; OTP sent to email","content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string","example":"Registration successful. Verification required."},"user_id":{"type":"integer","example":42},"verification_required":{"type":"boolean","example":true}}}}}},"400":{"description":"Validation error (invalid_json, missing_fields, invalid_email, weak_password)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Conflict (email_already_exists or username_already_exists)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/auth/otp/request":{"post":{"summary":"Request / Resend Verification OTP","description":"Sends a fresh 6-digit email verification OTP code. Rate-limited to once every 60 seconds per email.","tags":["Auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email"],"properties":{"email":{"type":"string","format":"email","example":"newuser@example.com"}}}}}},"responses":{"200":{"description":"OTP sent successfully","content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string","example":"Verification code sent."},"expires_in":{"type":"integer","example":300},"resend_after":{"type":"integer","example":60}}}}}},"400":{"description":"Missing email or malformed JSON","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Rate limited (wait 60 seconds before retrying)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/auth/otp/verify":{"post":{"summary":"Verify Account OTP","description":"Validates the 6-digit OTP code sent to the user email and marks the account as verified. Max 5 attempts per code.","tags":["Auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email","code"],"properties":{"email":{"type":"string","format":"email","example":"newuser@example.com"},"code":{"type":"string","example":"123456"}}}}}},"responses":{"200":{"description":"Account verified successfully","content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string","example":"Account verified successfully."},"verified":{"type":"boolean","example":true}}}}}},"400":{"description":"Invalid, expired, or max attempts exceeded OTP (invalid_otp, otp_expired, otp_attempts_exceeded)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/auth/login":{"post":{"summary":"User Login","description":"Authenticates a verified user using email and password and returns a JWT access & refresh token pair along with user info.","tags":["Auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email","password"],"properties":{"email":{"type":"string","format":"email","example":"student@example.com"},"password":{"type":"string","example":"StrongPassword123"}}}}}},"responses":{"200":{"description":"Login successful with JWT tokens","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}},"400":{"description":"Invalid credentials or malformed JSON","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Account not verified (`account_not_verified`) or disabled (`account_disabled`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/auth/token/refresh":{"post":{"summary":"Refresh Access Token","description":"Exchanges a valid refresh token for a new access & refresh token pair. Implements refresh token rotation (old refresh token is blacklisted).","tags":["Auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["refresh"],"properties":{"refresh":{"type":"string","description":"Valid JWT refresh token"}}}}}},"responses":{"200":{"description":"New JWT token pair issued","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TokenPair"}}}},"400":{"description":"Missing token or malformed JSON","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Invalid, expired, or revoked refresh token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Account disabled","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/auth/logout":{"post":{"summary":"User Logout","description":"Revokes the current Bearer access token and optionally revokes the refresh token provided in the request body.","tags":["Auth"],"security":[{"BearerAuth":[]}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"refresh":{"type":"string","description":"Optional refresh token to also blacklist"}}}}}},"responses":{"204":{"description":"Logged out successfully (No Content)"},"401":{"description":"Unauthorized — Missing, invalid, expired, or revoked Bearer JWT token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/auth/password/reset/request":{"post":{"summary":"Request Password Reset OTP","description":"Sends a 6-digit password reset code to an active user email address. Rate-limited to once every 60 seconds.","tags":["Auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email"],"properties":{"email":{"type":"string","format":"email","example":"student@example.com"}}}}}},"responses":{"200":{"description":"Password reset code sent","content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string","example":"Password reset code sent to your email."},"expires_in":{"type":"integer","example":300},"resend_after":{"type":"integer","example":60}}}}}},"400":{"description":"Missing email or malformed JSON","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"No active account found with this email (`user_not_found`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Rate limited (wait 60 seconds)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/auth/password/reset/confirm":{"post":{"summary":"Confirm Password Reset","description":"Verifies the 6-digit password reset OTP and sets the user's new password (minimum 8 characters).","tags":["Auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email","code","new_password"],"properties":{"email":{"type":"string","format":"email","example":"student@example.com"},"code":{"type":"string","example":"654321"},"new_password":{"type":"string","minLength":8,"example":"NewStrongPass123"}}}}}},"responses":{"200":{"description":"Password reset successful","content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string","example":"Password reset successful. You can now log in with your new password."},"success":{"type":"boolean","example":true}}}}}},"400":{"description":"Missing fields, weak password, invalid/expired OTP, or max attempts exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/users/me":{"get":{"summary":"Get Current User Profile","description":"Returns full profile details of the currently authenticated user.","tags":["Users"],"security":[{"BearerAuth":[]}],"responses":{"200":{"description":"Authenticated user profile","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserProfile"}}}},"401":{"description":"Unauthorized — Missing, invalid, expired, or revoked Bearer JWT token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"patch":{"summary":"Update Current User Profile","description":"Partially updates the authenticated user's `display_name` and/or `avatar_url`.","tags":["Users"],"security":[{"BearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"display_name":{"type":"string","example":"Hossein"},"avatar_url":{"type":"string","format":"uri","example":"https://example.com/avatar.jpg"}}}}}},"responses":{"200":{"description":"Updated user profile","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserProfile"}}}},"400":{"description":"Malformed JSON","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized — Missing, invalid, expired, or revoked Bearer JWT token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/tracks":{"get":{"summary":"List & Search Tracks","description":"Returns a paginated list of active tracks. Supports keyword search (`q` across title, artist, album — auto-syncs from OpenMusic if not cached locally), filtering by `artist`, and sorting via `ordering`. Pass optional Bearer token to populate `is_favorite`.","tags":["Tracks"],"security":[{},{"BearerAuth":[]}],"parameters":[{"name":"q","in":"query","description":"Search query (matches title, artist, or album)","schema":{"type":"string"}},{"name":"artist","in":"query","description":"Filter by artist name","schema":{"type":"string"}},{"name":"ordering","in":"query","description":"Sort order","schema":{"type":"string","enum":["title","-title","duration","-duration","created_at","-created_at"],"default":"-created_at"}},{"name":"page","in":"query","description":"Page number (1-indexed)","schema":{"type":"integer","minimum":1,"default":1}},{"name":"page_size","in":"query","description":"Number of items per page (min 1, max 50)","schema":{"type":"integer","minimum":1,"maximum":50,"default":20}}],"responses":{"200":{"description":"Paginated list of tracks","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaginatedTracks"}}}}}}},"/api/v1/tracks/featured":{"get":{"summary":"List Featured Tracks","description":"Returns a paginated list of editor-featured active tracks. Pass optional Bearer token to populate `is_favorite`.","tags":["Tracks"],"security":[{},{"BearerAuth":[]}],"parameters":[{"name":"page","in":"query","description":"Page number (1-indexed)","schema":{"type":"integer","minimum":1,"default":1}},{"name":"page_size","in":"query","description":"Number of items per page (min 1, max 50)","schema":{"type":"integer","minimum":1,"maximum":50,"default":20}}],"responses":{"200":{"description":"Paginated list of featured tracks","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaginatedTracks"}}}}}}},"/api/v1/tracks/{id}":{"get":{"summary":"Get Track Details","description":"Returns metadata and streaming URL for a single track by ID.","tags":["Tracks"],"security":[{},{"BearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"description":"Track unique ID","schema":{"type":"string","example":"T-GSYNW2VM3LVEQNIHGLU54T3Z5F6X7MHY"}}],"responses":{"200":{"description":"Track details","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Track"}}}},"404":{"description":"Track not found (`track_not_found`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/tracks/{id}/stream":{"get":{"summary":"Stream Track Audio (HTTP Range 206)","description":"Proxies the audio stream with full HTTP `Range` header support for instant seeking and mobile background streaming.","tags":["Tracks"],"parameters":[{"name":"id","in":"path","required":true,"description":"Track unique ID","schema":{"type":"string","example":"T-GSYNW2VM3LVEQNIHGLU54T3Z5F6X7MHY"}},{"name":"Range","in":"header","required":false,"description":"Byte range for partial content streaming (e.g., `bytes=0-1048575`)","schema":{"type":"string","example":"bytes=0-1048575"}}],"responses":{"200":{"description":"Full audio stream","content":{"audio/mpeg":{"schema":{"type":"string","format":"binary"}}}},"206":{"description":"Partial Content audio stream","headers":{"Content-Range":{"schema":{"type":"string","example":"bytes 0-1048575/6451200"}},"Accept-Ranges":{"schema":{"type":"string","example":"bytes"}}},"content":{"audio/mpeg":{"schema":{"type":"string","format":"binary"}}}},"404":{"description":"Track not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/tracks/{id}/debug-stream":{"get":{"summary":"Debug Track Stream Resolution","description":"Diagnostic endpoint returning track source info, resolved YouTube audio ID, playback metadata, and upstream stream diagnostics.","tags":["Tracks"],"parameters":[{"name":"id","in":"path","required":true,"description":"Track unique ID","schema":{"type":"string"}}],"responses":{"200":{"description":"Diagnostic payload","content":{"application/json":{"schema":{"type":"object","properties":{"track":{"type":"object"},"ytAudioId":{"type":"string","nullable":true},"playbackData":{"type":"object","nullable":true},"diagnostics":{"type":"object","nullable":true}}}}}},"404":{"description":"Track not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/favorites":{"get":{"summary":"List User Favorites","description":"Returns a paginated list of tracks favorited by the authenticated user, ordered by most recently added.","tags":["Favorites"],"security":[{"BearerAuth":[]}],"parameters":[{"name":"page","in":"query","description":"Page number (1-indexed)","schema":{"type":"integer","minimum":1,"default":1}},{"name":"page_size","in":"query","description":"Number of items per page (min 1, max 50)","schema":{"type":"integer","minimum":1,"maximum":50,"default":20}}],"responses":{"200":{"description":"Paginated list of favorite tracks","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaginatedFavorites"}}}},"401":{"description":"Unauthorized — Missing, invalid, expired, or revoked Bearer JWT token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"post":{"summary":"Add Track to Favorites","description":"Marks a track as favorite for the authenticated user.","tags":["Favorites"],"security":[{"BearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["track_id"],"properties":{"track_id":{"type":"string","example":"T-GSYNW2VM3LVEQNIHGLU54T3Z5F6X7MHY"}}}}}},"responses":{"201":{"description":"Track added to favorites","content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string","example":"Track added to favorites."},"track_id":{"type":"string"},"is_favorite":{"type":"boolean","example":true}}}}}},"400":{"description":"Missing track_id or malformed JSON","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized — Missing, invalid, expired, or revoked Bearer JWT token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Track does not exist","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Track is already in favorites (`already_favorited`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/favorites/{track_id}":{"delete":{"summary":"Remove Track from Favorites","description":"Removes the specified track from the authenticated user's favorites.","tags":["Favorites"],"security":[{"BearerAuth":[]}],"parameters":[{"name":"track_id","in":"path","required":true,"description":"Track ID to unfavorite","schema":{"type":"string","example":"T-GSYNW2VM3LVEQNIHGLU54T3Z5F6X7MHY"}}],"responses":{"204":{"description":"Removed from favorites (No Content)"},"401":{"description":"Unauthorized — Missing, invalid, expired, or revoked Bearer JWT token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/playlists":{"get":{"summary":"List User Playlists","description":"Returns a paginated list of playlists owned by the authenticated user.","tags":["Playlists"],"security":[{"BearerAuth":[]}],"parameters":[{"name":"page","in":"query","description":"Page number (1-indexed)","schema":{"type":"integer","minimum":1,"default":1}},{"name":"page_size","in":"query","description":"Number of items per page (min 1, max 50)","schema":{"type":"integer","minimum":1,"maximum":50,"default":20}}],"responses":{"200":{"description":"Paginated list of playlists","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaginatedPlaylists"}}}},"401":{"description":"Unauthorized — Missing, invalid, expired, or revoked Bearer JWT token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"post":{"summary":"Create Playlist","description":"Creates a new playlist for the authenticated user.","tags":["Playlists"],"security":[{"BearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name"],"properties":{"name":{"type":"string","example":"Road Trip"},"description":{"type":"string","example":"Best driving songs"},"is_public":{"type":"boolean","default":false}}}}}},"responses":{"201":{"description":"Playlist created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Playlist"}}}},"400":{"description":"Missing name or malformed JSON","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized — Missing, invalid, expired, or revoked Bearer JWT token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/playlists/{id}":{"get":{"summary":"Get Playlist Details","description":"Returns playlist metadata along with its ordered list of tracks. Accessible by owner or if playlist `is_public` is true.","tags":["Playlists"],"security":[{"BearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"description":"Playlist integer ID","schema":{"type":"integer","example":1}}],"responses":{"200":{"description":"Playlist details with tracks","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlaylistDetail"}}}},"400":{"description":"Invalid playlist ID","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized — Missing, invalid, expired, or revoked Bearer JWT token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Permission denied (private playlist owned by another user)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Playlist not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"patch":{"summary":"Update Playlist","description":"Partially updates a playlist's `name`, `description`, or `is_public` visibility. Owner only.","tags":["Playlists"],"security":[{"BearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"description":"Playlist integer ID","schema":{"type":"integer","example":1}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","example":"Updated Playlist Name"},"description":{"type":"string","example":"Updated description"},"is_public":{"type":"boolean","example":true}}}}}},"responses":{"200":{"description":"Playlist updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Playlist"}}}},"400":{"description":"Malformed JSON","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized — Missing, invalid, expired, or revoked Bearer JWT token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Permission denied (not owner)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Playlist not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"delete":{"summary":"Delete Playlist","description":"Permanently deletes a playlist owned by the authenticated user.","tags":["Playlists"],"security":[{"BearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"description":"Playlist integer ID","schema":{"type":"integer","example":1}}],"responses":{"204":{"description":"Playlist deleted (No Content)"},"401":{"description":"Unauthorized — Missing, invalid, expired, or revoked Bearer JWT token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Permission denied (not owner)","